{
  "name": "yaarimeet",
  "main": "src/worker.js",
  // No public workers.dev address: the site at yaarimeet.pages.dev reaches
  // this Worker through a service binding (see pages/wrangler.jsonc).
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/ws", "/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "LOBBY", "class_name": "Lobby" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby"] }],
  "vars": {
    // Filled in during setup. Secrets (SUPABASE_SECRET_KEY, VAPID_PRIVATE_JWK)
    // are set with `npx wrangler secret put`, never written here.
    "SUPABASE_URL": "https://tnzxkxkodqqhvypwbsnj.supabase.co",
    "VAPID_PUBLIC_KEY": "BNXnqzxCHcx4-S4INvTu-mvtJZ471fsZr6g-lVjaDQY6nJKTfNC6QltcPQC_GjAQ7u2kB688MokHiOAiGmMCBWA"
  },
  "observability": { "enabled": true }
}
